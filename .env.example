# Model access — needed ONLY for the cassette recording pass.
# Replay runs (and therefore CI) never read these.
ANTHROPIC_API_KEY=sk-ant-replace-me
# OPENAI_API_KEY=sk-replace-me

# Postgres (docker compose service `postgres`, published on 5433 to avoid collisions)
MERIDIAN_DATABASE_URL=postgresql://meridian:meridian@localhost:5433/meridian

# Proxy mode: record | replay | passthrough
# `passthrough` is rejected by config validation in gate mode.
MERIDIAN_PROXY_MODE=replay
